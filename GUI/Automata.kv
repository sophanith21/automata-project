#:kivy 2.3.1

WindowManager:
    Screen:
        name: "Welcome"
        BoxLayout:
            orientation: 'vertical'
            Label:
                text: 'Welcome to Automata Processor'
                font_size: 30
        
            Button:
                text: 'See your defined finite automatas'
                on_release: 
                    app.update_fa_list_widget()
                    app.root.current = 'first'

    FirstWindow: 
        
    SecondWindow:

<FirstWindow>:
    name: 'first'
    FAListWidget:
        id: fa_list_widget_id

<SecondWindow>:
    name: 'second'
    FADetailWidget:
        id: fa_detail_widget_id

<FAListWidget>:
    orientation: 'vertical'

<FAWidget>:
    orientation: 'horizontal'
    Label:
        text: "Name: " + root.fa_name
        color: 0, 1, 1, 1
    Label:
        text: "Type: " + root.fa_type
        color: 0, 1, 1, 1
    Label:
        text: "Description: " + root.fa_description
        color: 0, 1, 1, 1
    Button:
        text: 'View'
        color: 0, 1, 1, 1
        on_release:
            app.selected_fa_id = root.fa_id
            app.update_fa_details_widget()
            app.root.current = "second"
            app.root.transition.direction = "left"
            
            

<FADetailWidget>:
    orientation: 'vertical'