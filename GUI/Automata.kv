#:kivy 2.3.1

MainWidget:

<MainWidget>:
    orientation: 'vertical'
    
    

<FA>:
    orientation: 'horizontal'
    height: dp(80)  
    padding: dp(5)
    spacing: dp(5)
    Label: 
        text: "Name: " + root.fa_name
        color: 0, 1, 1, 1
    Label: 
        text: "Type: " +root.fa_type
        color: 0, 1, 1, 1
    
    Label: 
        text: "Description: " +root.fa_description
        color: 0, 1, 1, 1
    Button:
        text: 'View'
        color: 0, 1, 1, 1
            